# Local SQLite (default — works offline, no Turso account needed)
TURSO_DATABASE_URL=file:local.db

# Docker / Unraid local SQLite on the /data volume:
# TURSO_DATABASE_URL=file:/data/hourmark.db

# Turso remote: replace the URL and set your auth token
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# Public URL of the app. Needed in Docker for form actions / CSRF, and it is also
# where the OIDC redirect URI is built from — so it must match the browser URL.
# ORIGIN=https://hourmark.holroydnet.uk


# --- Sign-in (Holroyd ID) -----------------------------------------------------
#
# Hourmark registers itself with the provider on every boot and needs no client
# id and no secret to do it: registration on a trusted domain is authorised by
# where the app lives. On holroydnet.uk, everything below can stay unset.
#
# See holroydnet/auth `docs/integrating.md`.

# The OIDC provider. Defaults to https://auth.holroydnet.uk.
# AUTH_ISSUER=https://auth.holroydnet.uk

# Local development: localhost is not a trusted domain, so tokenless registration
# is refused. Pick one, in order of preference:
#
#   1. Point a hostname on the trusted domain at localhost and run the app there
#      (host labels are matched, so http:// is fine):
#      ORIGIN=http://hourmark.localhost.holroydnet.uk:5173
#   2. Add your dev origin's domain to TRUSTED_DOMAINS on your local provider.
#   3. Register with a token, which skips the domain check entirely:
#      APP_REGISTRATION_TOKEN=…
#
# Either way an admin still has to grant your account access before you can sign in.

# Registration replaces `redirect_uris` wholesale, so two environments registering
# the same slug will fight over the list. List every callback here instead, or use
# a separate slug per environment.
# AUTH_EXTRA_REDIRECT_URIS=http://localhost:5173/auth/callback

# Only for a confidential registration (one made with APP_REGISTRATION_TOKEN):
# the provider generates the id and returns the secret exactly once.
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# Skip the boot-time registration call — for a provider you do not administer, or
# when the app is registered by hand.
# AUTH_REGISTER_ON_BOOT=false
